---
interface Props {
  currentPath?: string;
  pendingCount?: number;
  adminName?: string;
  adminRole?: string;
}

const {
  currentPath = '/admin',
  pendingCount = 0,
  adminName = 'Faiz I.',
  adminRole = 'Executive Advisor'
} = Astro.props;

const navItems = [
  { label: 'Executive Dashboard', path: '/admin', icon: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6' },
  { label: 'Student Lead CRM', path: '/admin/leads', icon: 'M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z', badge: pendingCount > 0 ? pendingCount : null },
  { label: '1-on-1 Consultations', path: '/admin/consultations', icon: 'M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z' },
  { label: 'Services Manager', path: '/admin/services', icon: 'M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z' },
  { label: 'Destinations & Unis', path: '/admin/destinations', icon: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5m0 0h5m-5 0V11m0 10V11m0-10a2 2 0 012 2v4a2 2 0 01-2 2' },
  { label: 'FAQ Knowledgebase', path: '/admin/faqs', icon: 'M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z' },
  { label: 'Blog CMS', path: '/admin/blog', icon: 'M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z' },
  { label: 'Platform Settings', path: '/admin/settings', icon: 'M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z' },
];
---

<!-- Sidebar Mobile Backdroop Overlay -->
<div id="admin-sidebar-backdrop" class="fixed inset-0 bg-slate-900/60 z-40 lg:hidden hidden backdrop-blur-xs"></div>

<aside id="admin-sidebar" class="fixed top-0 left-0 bottom-0 w-72 bg-[#0F172A] text-slate-300 z-50 flex flex-col justify-between border-r border-slate-800 transition-transform duration-300 transform -translate-x-full lg:translate-x-0 shadow-2xl">
  
  <!-- Header / Brand Section -->
  <div>
    <div class="p-6 border-b border-slate-800/80 flex items-center justify-between">
      <a href="/admin" class="flex items-center gap-3 group">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-[#C8102E] to-red-800 flex items-center justify-center text-white font-serif font-black text-lg shadow-md group-hover:scale-105 transition-transform">
          FA
        </div>
        <div>
          <h1 class="text-sm font-extrabold text-white tracking-wide font-serif">FlyAustria</h1>
          <span class="inline-flex items-center gap-1.5 text-[10px] font-bold text-slate-400 uppercase tracking-widest">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            Executive CRM
          </span>
        </div>
      </a>

      <!-- Mobile Close Button -->
      <button id="admin-sidebar-close" class="lg:hidden p-1.5 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <!-- Navigation List -->
    <nav class="p-4 space-y-1 overflow-y-auto max-h-[calc(100vh-220px)]">
      {navItems.map((item) => {
        const isActive = currentPath === item.path || (item.path !== '/admin' && currentPath.startsWith(item.path));
        return (
          <a
            href={item.path}
            class={`flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-bold transition-all duration-200 ${
              isActive
                ? 'bg-[#C8102E] text-white shadow-md shadow-red-900/30'
                : 'text-slate-400 hover:text-white hover:bg-slate-800/60'
            }`}
          >
            <div class="flex items-center gap-3">
              <svg class="w-4 h-4 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
              </svg>
              <span>{item.label}</span>
            </div>
            {item.badge && (
              <span class={`px-2 py-0.5 rounded-full text-[10px] font-extrabold ${isActive ? 'bg-white text-[#C8102E]' : 'bg-red-500/20 text-red-400 border border-red-500/30'}`}>
                {item.badge}
              </span>
            )}
          </a>
        );
      })}
    </nav>
  </div>

  <!-- Bottom Section: Admin Profile + Actions -->
  <div class="p-4 border-t border-slate-800/80 space-y-3 bg-[#0B1120]">
    
    <!-- Profile Mini Card -->
    <div class="flex items-center gap-3 p-2.5 rounded-xl bg-slate-800/50 border border-slate-700/50">
      <div class="w-9 h-9 rounded-full bg-slate-700 text-slate-200 font-bold text-xs flex items-center justify-center shrink-0 border border-slate-600">
        FI
      </div>
      <div class="flex-1 min-w-0">
        <h4 class="text-xs font-bold text-white truncate">{adminName}</h4>
        <p class="text-[10px] text-slate-400 truncate">{adminRole}</p>
      </div>
    </div>

    <!-- Links & Logout -->
    <div class="grid grid-cols-2 gap-2 text-[11px] font-bold">
      <a
        href="/"
        target="_blank"
        class="flex items-center justify-center gap-1.5 py-2 px-3 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white transition-colors"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        <span>Public Site</span>
      </a>

      <button
        id="admin-logout-btn"
        class="flex items-center justify-center gap-1.5 py-2 px-3 rounded-lg bg-red-950/40 hover:bg-red-900/60 text-red-300 hover:text-red-100 transition-colors border border-red-900/30 cursor-pointer"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
        <span>Logout</span>
      </button>
    </div>

  </div>
</aside>

<script>
  // Mobile drawer sidebar toggle
  const sidebar = document.getElementById('admin-sidebar');
  const backdrop = document.getElementById('admin-sidebar-backdrop');
  const closeBtn = document.getElementById('admin-sidebar-close');

  closeBtn?.addEventListener('click', () => {
    sidebar?.classList.add('-translate-x-full');
    backdrop?.classList.add('hidden');
  });

  backdrop?.addEventListener('click', () => {
    sidebar?.classList.add('-translate-x-full');
    backdrop?.classList.add('hidden');
  });

  // Logout POST fetch logic
  document.getElementById('admin-logout-btn')?.addEventListener('click', async () => {
    if (confirm('Are you sure you want to sign out of FlyAustria Executive CRM?')) {
      try {
        await fetch('/api/admin/logout', { method: 'POST' });
        window.location.href = '/admin/login';
      } catch (err) {
        window.location.href = '/admin/login';
      }
    }
  });
</script>
