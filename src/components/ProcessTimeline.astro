---
const steps = [
  {
    step: '01',
    title: 'Free Profile & Eligibility Assessment',
    desc: 'Our Kochi team evaluates your Kerala university degree (B.Tech, B.Sc, B.Com, B.A), CGPA, and course credits to shortlist tuition-free Austrian public universities.',
    deliverables: [
      'University eligibility audit & credit match',
      'Intake deadline timeline & document checklist',
      '1-on-1 consultation with Austria specialist'
    ],
    tag: 'Phase 1 • Kochi Office',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`,
  },
  {
    step: '02',
    title: 'MEA Apostille & Document Legalization',
    desc: 'We manage the entire authentication workflow for your degree certificate, marksheets, syllabus copy, and police clearance certificate through MEA New Delhi & Embassy.',
    deliverables: [
      'Kerala state Home Dept authentication',
      'MEA India Apostille attestation in New Delhi',
      'Certified German translation by embassy translator'
    ],
    tag: 'Phase 2 • Document Verification',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>`,
  },
  {
    step: '03',
    title: 'Public University Application Filing',
    desc: 'Direct submission of your complete application portfolio to top public universities (University of Vienna, TU Graz, TU Wien, JKU Linz) before intake deadlines.',
    deliverables: [
      'Motivation letter & Academic CV drafting',
      'Direct university portal submission & tracking',
      'Offer letter & admission confirmation issuance'
    ],
    tag: 'Phase 3 • University Filing',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 14l9-5-9-5-9 5 9 5z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0112 20.055a11.952 11.952 0 01-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"/></svg>`,
  },
  {
    step: '04',
    title: 'OEAD Student Dorm Accommodation Lock',
    desc: 'Securing official student housing confirmation (OEAD or Wihast dorms in Vienna/Graz) required as proof of accommodation for Austrian visa approval.',
    deliverables: [
      'Guaranteed OEAD dorm booking contract',
      'Affordable student dorm room (€320–€480/mo)',
      'Official rental contract for embassy visa file'
    ],
    tag: 'Phase 4 • Housing Lock',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>`,
  },
  {
    step: '05',
    title: 'Austrian Residence Permit Visa Filing',
    desc: 'Expert preparation of your Aufenthaltsbewilligung Studierende visa file for the Austrian Embassy (VFS New Delhi) with 98%+ approval record and bank proof guidance.',
    deliverables: [
      'NO blocked account required (Indian bank proof)',
      'VFS Embassy appointment booking & mock interview',
      'Full health insurance setup (ÖGK compliance)'
    ],
    tag: 'Phase 5 • Embassy Visa File',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>`,
  },
  {
    step: '06',
    title: 'Pre-Departure Briefing & Vienna Arrival',
    desc: 'Complete pre-departure briefing in Kochi, airport pickup in Vienna or Graz, municipal residence registration (Meldezettel), and Austrian bank account opening.',
    deliverables: [
      'In-person pre-departure orientation in Kochi',
      'Vienna/Graz airport reception & dorm key handoff',
      'Meldezettel registration & Austrian bank account'
    ],
    tag: 'Phase 6 • On-Ground Austria',
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M5 13l4 4L19 7"/></svg>`,
  },
];
---

<section class="py-20 sm:py-28 bg-[#FAF9F6] border-y border-slate-200/90 relative" id="process">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-red-50 border border-red-200 text-[#C8102E] text-xs font-bold uppercase tracking-wider mb-3">
        <span>Transparent 6-Step Workflow</span>
      </span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#0F172A] tracking-tight font-serif">
        From Kerala to Austria: Step-by-Step
      </h2>
      <p class="text-slate-600 text-sm sm:text-base mt-3 leading-relaxed">
        Our documented, end-to-end process guarantees zero surprises, clear milestones, and dedicated Kochi support from profile check to airport pickup.
      </p>
    </div>

    <!-- Process Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 relative">
      {steps.map((item) => (
        <div class="relative bg-white p-7 rounded-2xl border border-slate-200/90 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between group">
          
          <div>
            <!-- Badge & Step Number -->
            <div class="flex items-center justify-between mb-5 gap-2">
              <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-xl bg-slate-900 text-white flex items-center justify-center font-extrabold text-base sm:text-lg shadow-sm group-hover:bg-[#C8102E] transition-colors shrink-0">
                {item.step}
              </div>
              <span class="text-[10px] sm:text-[11px] font-bold px-2.5 py-1 rounded-full bg-slate-100 text-slate-700 border border-slate-200/60 truncate max-w-[200px]">
                {item.tag}
              </span>
            </div>

            <!-- Title & Inline Icon -->
            <div class="flex items-start gap-3 mb-3">
              <div class="p-2 rounded-lg bg-red-50 text-[#C8102E] shrink-0 mt-0.5" set:html={item.icon} />
              <h3 class="text-base sm:text-xl font-bold text-[#0F172A] leading-snug font-serif">
                {item.title}
              </h3>
            </div>

            <!-- Description -->
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mb-5">
              {item.desc}
            </p>

            <!-- Key Deliverables List -->
            <div class="space-y-2 border-t border-slate-100 pt-4 mb-4">
              <span class="text-[11px] font-extrabold uppercase tracking-wider text-slate-400 block mb-2">Key Deliverables</span>
              {item.deliverables.map((d) => (
                <div class="flex items-start gap-2 text-xs font-semibold text-slate-700">
                  <span class="text-emerald-600 font-bold shrink-0 mt-0.5">✓</span>
                  <span>{d}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Bottom Footer Line -->
          <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-[11px] font-bold text-slate-500">
            <span>FlyAustria Guaranteed</span>
            <span class="text-[#C8102E] group-hover:translate-x-1 transition-transform">Details →</span>
          </div>

        </div>
      ))}
    </div>

    <!-- Process Trust Banner -->
    <div class="mt-10 sm:mt-14 p-5 sm:p-8 rounded-2xl sm:rounded-3xl bg-[#0F172A] text-white flex flex-col sm:flex-row items-center justify-between gap-5 sm:gap-6 shadow-xl">
      <div class="space-y-1 text-center sm:text-left">
        <h4 class="text-base sm:text-lg font-bold">Have questions about your university qualification or document Apostille?</h4>
        <p class="text-xs text-slate-300">Book a 15-minute eligibility evaluation call with our Kochi senior consultant.</p>
      </div>
      <a
        href="https://wa.me/919876543210?text=Hi%20FlyAustria!%20I%20want%20to%20discuss%20my%20application%20and%20process."
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto min-h-[48px] justify-center bg-[#C8102E] hover:bg-red-700 text-white text-xs font-bold uppercase tracking-wider px-6 py-3.5 rounded-full shadow-md transition-all shrink-0 flex items-center gap-2 active:scale-95"
      >
        <span>Schedule Free Call</span>
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path d="M13.025 1l-1.42 1.414 6.586 6.586h-18.191v2h18.191l-6.586 6.586 1.42 1.414 9-9z"/>
        </svg>
      </a>
    </div>

  </div>
</section>
