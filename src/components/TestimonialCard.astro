---
interface Props {
  studentName: string;
  homeCity: string;
  universityName: string;
  course: string;
  graduationYear: string;
  quote: string;
  visaApprovedDate: string;
  rating?: number;
}

const { studentName, homeCity, universityName, course, quote, visaApprovedDate, rating = 5 } = Astro.props;
---

<div class="glass-panel p-6 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition-all flex flex-col justify-between">
  <div>
    <!-- Rating Stars & Visa Badge -->
    <div class="flex items-center justify-between mb-4">
      <div class="flex items-center gap-1 text-amber-400">
        {Array.from({ length: rating }).map(() => (
          <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
          </svg>
        ))}
      </div>
      <span class="inline-flex items-center gap-1 text-[11px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200 px-2.5 py-0.5 rounded-full">
        <svg class="w-3 h-3 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
        </svg>
        Visa Approved ({visaApprovedDate})
      </span>
    </div>

    <!-- Quote -->
    <p class="text-sm text-slate-700 italic leading-relaxed mb-6">
      "{quote}"
    </p>
  </div>

  <!-- Student Info -->
  <div class="pt-4 border-t border-slate-100 flex items-center gap-3">
    <div class="w-10 h-10 rounded-full bg-gradient-to-br from-red-500 to-amber-500 text-white font-bold text-sm flex items-center justify-center shrink-0">
      {studentName.charAt(0)}
    </div>
    <div>
      <h4 class="text-sm font-bold text-slate-900 leading-tight">{studentName}</h4>
      <p class="text-xs text-slate-500">{homeCity} • <span class="font-medium text-[#C8102E]">{universityName}</span></p>
      <p class="text-[11px] text-slate-400 mt-0.5">{course}</p>
    </div>
  </div>
</div>
