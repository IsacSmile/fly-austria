    <!-- Bottom Trust Metrics Bar -->
    <div class="bg-white border border-slate-200/90 rounded-2xl sm:rounded-full py-3 px-4 sm:px-10 shadow-xs flex flex-wrap items-center justify-center gap-3 sm:gap-4 max-w-3xl mx-auto mt-6 sm:mt-8 text-[11px] sm:text-xs font-bold text-slate-700 text-center">
