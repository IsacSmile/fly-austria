<section class="py-12 sm:py-20 bg-[#FAF9F6] relative overflow-hidden" id="student-stories">
  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    
    <!-- Top Header -->
    <div class="text-center mb-8">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#0F172A] text-emerald-400 text-[10px] sm:text-[11px] font-extrabold uppercase tracking-widest shadow-xs mb-3">
        <span>✨ VERIFIED STUDENT SUCCESS STORIES</span>
      </div>
      <h2 class="text-2xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 font-serif tracking-tight mb-2">
        Real Students. Proven Pathways.
      </h2>
      <p class="text-slate-600 text-xs sm:text-base max-w-xl mx-auto leading-relaxed px-2">
        Hear directly from international students successfully studying in top Austrian public universities.
      </p>
    </div>

    <!-- Student Avatar Selector Wrap (Wrapped rows on mobile, exact matching prompt!) -->
    <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3 max-w-md sm:max-w-xl mx-auto mb-8 px-1">
      {testimonials.map((student, idx) => (
        <button
          type="button"
          data-testimonial-btn={idx}
          class={`testimonial-pill-btn px-3.5 py-1.5 sm:px-4 sm:py-2 rounded-full text-xs font-bold flex items-center gap-2 transition-all duration-200 border cursor-pointer ${
            idx === 6
              ? 'bg-[#0F172A] text-white border-slate-800 shadow-md ring-2 ring-emerald-400/40 scale-105'
              : 'bg-white text-slate-700 hover:bg-slate-50 border-slate-200/90 shadow-xs'
          }`}
        >
          <img
            src={student.avatar}
            alt={student.name}
            class="w-5 h-5 sm:w-6 sm:h-6 rounded-full object-cover border border-white shrink-0"
            loading="lazy"
          />
          <span class="whitespace-nowrap">{student.name}</span>
        </button>
      ))}
    </div>

    <!-- Active Testimonial Card Display -->
    <div class="relative">
      {testimonials.map((student, idx) => (
        <div
          data-testimonial-card={idx}
          class={`testimonial-card transition-all duration-300 ${idx === 6 ? 'block' : 'hidden'}`}
        >
          <div class="relative bg-white border border-slate-200/90 rounded-3xl sm:rounded-[2rem] p-5 sm:p-9 shadow-xl shadow-slate-900/5 max-w-3xl mx-auto">
            
            <!-- Decorative Pink/Red Quote Mark -->
            <div class="absolute top-3 right-5 sm:top-5 sm:right-8 text-red-100 font-serif text-5xl sm:text-7xl select-none opacity-90 leading-none">
              ”
            </div>

            <!-- Student Profile Header (Mobile Side-by-Side Flex Layout) -->
            <div class="flex flex-row items-start gap-3.5 sm:gap-5 relative z-10">
              
              <!-- Avatar with Red VERIFIED Badge Overlay -->
              <div class="relative w-16 h-16 sm:w-24 sm:h-24 rounded-2xl overflow-hidden border border-slate-200 shadow-md shrink-0">
                <img
                  src={student.avatar}
                  alt={student.fullName}
                  class="w-full h-full object-cover"
                />
                <div class="absolute bottom-0 inset-x-0 bg-[#C8102E] text-white text-[8px] sm:text-[9px] font-extrabold uppercase py-0.5 text-center tracking-wider leading-none">
                  VERIFIED ✓
                </div>
              </div>

              <!-- Details Block -->
              <div class="flex-1 min-w-0 space-y-1">
                <div class="flex flex-wrap items-center gap-1.5 mb-1">
                  <!-- Star Rating -->
                  <div class="flex items-center gap-0.5 text-red-600 text-xs sm:text-sm">
                    ★ ★ ★ ★ ★
                  </div>
                  <!-- Tag Badge -->
                  <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-red-50 text-[#C8102E] text-[9px] sm:text-[10px] font-extrabold uppercase tracking-wider border border-red-200/70">
                    <span>{student.tagIcon}</span>
                    <span>{student.admissionType}</span>
                  </span>
                </div>

                <h3 class="text-lg sm:text-2xl font-extrabold text-slate-900 font-serif tracking-tight leading-tight">
                  {student.fullName}
                </h3>
                <p class="text-xs sm:text-sm text-slate-600 flex items-center gap-1 font-medium truncate">
                  <span>🏛️</span>
                  <span class="font-semibold text-slate-800 truncate">{student.university}</span>
                </p>
                <p class="text-[11px] sm:text-xs text-slate-500 flex items-center gap-1 truncate">
                  <span>🎓</span>
                  <span class="truncate">{student.degree}</span>
                </p>
              </div>

            </div>

            <!-- Quote Text -->
