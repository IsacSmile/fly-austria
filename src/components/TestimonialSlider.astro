      <span class="text-slate-300">|</span>
      <div class="flex items-center gap-1.5">
        <span class="w-4 h-4 rounded-full bg-red-100 text-[#C8102E] flex items-center justify-center text-[10px] font-bold">✓</span>
        <span>150+ Kerala Students</span>
      </div>
      <span class="hidden sm:inline text-slate-300">|</span>
      <div class="hidden sm:flex items-center gap-1.5">
        <span class="w-4 h-4 rounded-full bg-red-100 text-[#C8102E] flex items-center justify-center text-[10px] font-bold">✓</span>
        <span>4.9 / 5 Rating</span>
      </div>
    </div>

  </div>
</section>

<script>
  let currentIndex = 6; // Sneha active by default matching prompt image
  const pillBtns = document.querySelectorAll('.testimonial-pill-btn');
  const cards = document.querySelectorAll('[data-testimonial-card]');
  const counterEl = document.getElementById('testimonial-counter');
  const prevBtn = document.getElementById('prev-testimonial-btn');
  const nextBtn = document.getElementById('next-testimonial-btn');

  const total = cards.length;

  function showTestimonial(index) {
    currentIndex = (index + total) % total;

    // Update active pill button state
    pillBtns.forEach((btn, idx) => {
      if (idx === currentIndex) {
        btn.className = 'testimonial-pill-btn px-3.5 py-1.5 sm:px-4 sm:py-2 rounded-full text-xs font-bold flex items-center gap-2 transition-all duration-200 border cursor-pointer bg-[#0F172A] text-white border-slate-800 shadow-md ring-2 ring-emerald-400/40 scale-105';
      } else {
        btn.className = 'testimonial-pill-btn px-3.5 py-1.5 sm:px-4 sm:py-2 rounded-full text-xs font-bold flex items-center gap-2 transition-all duration-200 border cursor-pointer bg-white text-slate-700 hover:bg-slate-50 border-slate-200/90 shadow-xs';
      }
    });

    // Update active card display
    cards.forEach((card, idx) => {
      if (idx === currentIndex) {
        card.classList.remove('hidden');
        card.classList.add('block');
      } else {
        card.classList.remove('block');
        card.classList.add('hidden');
      }
    });

    // Update counter text
    if (counterEl) {
      counterEl.textContent = `Student ${currentIndex + 1} of ${total}`;
    }
  }

  // Add click handlers to pill buttons
  pillBtns.forEach((btn, idx) => {
    btn.addEventListener('click', () => showTestimonial(idx));
  });

  // Next / Prev click handlers
  if (prevBtn) {
    prevBtn.addEventListener('click', () => showTestimonial(currentIndex - 1));
  }
  if (nextBtn) {
    nextBtn.addEventListener('click', () => showTestimonial(currentIndex + 1));
  }
</script>
