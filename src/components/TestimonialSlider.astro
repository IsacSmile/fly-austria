          class="w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-[#0F172A] hover:bg-[#C8102E] text-white flex items-center justify-center transition-all shadow-xs active:scale-95 cursor-pointer text-base font-bold"
        >
