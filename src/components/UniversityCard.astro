---
interface Props {
  name: string;
  germanName: string;
  city: string;
  tuitionFee: string;
  ranking: string;
  popularCourses: string;
  websiteUrl: string;
  description: string;
}

const { name, germanName, city, tuitionFee, ranking, popularCourses, websiteUrl, description } = Astro.props;
---

<div class="bg-white rounded-2xl border border-slate-200 p-5 sm:p-6 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between">
  <div>
    <div class="flex flex-col sm:flex-row items-start justify-between gap-2 sm:gap-4 mb-3">
      <div>
        <span class="inline-block px-2.5 py-1 rounded-full text-xs font-semibold bg-red-50 text-[#C8102E] border border-red-100 mb-2">
          {city}, Austria
        </span>
        <h3 class="text-base sm:text-lg font-bold text-slate-900 leading-snug">{name}</h3>
        <p class="text-xs text-slate-500 italic mt-0.5">{germanName}</p>
      </div>
      <div class="text-left sm:text-right shrink-0 mt-1 sm:mt-0 bg-emerald-50 sm:bg-transparent px-3 py-1 sm:p-0 rounded-lg">
        <span class="block text-[10px] sm:text-xs font-medium text-slate-500 sm:text-slate-400">Public Tuition</span>
        <span class="text-xs sm:text-sm font-extrabold text-emerald-700 sm:text-green-600">{tuitionFee}</span>
      </div>
    </div>

    <p class="text-xs text-slate-600 leading-relaxed mb-4">
      {description}
    </p>

    <div class="space-y-2 mb-4 bg-slate-50 p-3.5 rounded-xl border border-slate-100 text-xs">
      <div>
        <span class="font-semibold text-slate-700">World Ranking:</span>
        <span class="text-slate-600 ml-1">{ranking}</span>
      </div>
      <div>
        <span class="font-semibold text-slate-700">Popular English Programs:</span>
        <span class="text-slate-600 ml-1">{popularCourses}</span>
      </div>
    </div>
  </div>

  <div class="pt-4 border-t border-slate-100 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 text-xs">
    <a
      href={websiteUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="text-slate-500 hover:text-slate-900 font-medium inline-flex items-center justify-center gap-1 min-h-[40px] px-2"
    >
      <span>Official Portal</span>
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
      </svg>
    </a>

    <a
      href={`https://wa.me/919876543210?text=Hi%20FlyAustria!%20I%20want%20to%20apply%20to%20${encodeURIComponent(name)}.`}
      target="_blank"
      rel="noopener noreferrer"
      class="btn-primary min-h-[44px] py-2.5 px-4 text-xs rounded-xl font-bold uppercase tracking-wider justify-center active:scale-95"
    >
      Apply via FlyAustria
    </a>
  </div>
</div>
