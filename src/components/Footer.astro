---
const currentYear = new Date().getFullYear();
---

<footer class="bg-[#0F172A] text-slate-300 pt-16 pb-12 border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 pb-12 border-b border-slate-800">
      
      <!-- Brand & Mission -->
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <a href="/" class="inline-block focus:outline-none focus:ring-2 focus:ring-[#C8102E] rounded-lg">
            <img src="/images/logo.png" alt="FlyAustria Study Abroad Logo" class="h-10 w-auto" />
          </a>
          <span class="text-xs bg-red-950 text-red-400 px-2.5 py-0.5 rounded-full border border-red-800/50 font-semibold">Kochi Exclusive</span>
        </div>
        <p class="text-sm text-slate-400 leading-relaxed">
          Kerala’s first consultancy dedicated 100% to Austrian public universities, student residence permits, MEA apostille, and student housing.
        </p>
        <div class="flex items-center gap-3 pt-2">
          <a
            href="https://instagram.com/flyaustria.in"
            target="_blank"
            rel="noopener noreferrer"
            class="w-11 h-11 rounded-xl bg-slate-800 text-slate-300 hover:text-white hover:bg-slate-700 transition-colors flex items-center justify-center active:scale-95"
            aria-label="FlyAustria Instagram"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
          <a
            href="https://wa.me/919876543210"
            target="_blank"
            rel="noopener noreferrer"
            class="w-11 h-11 rounded-xl bg-slate-800 text-green-400 hover:text-green-300 hover:bg-slate-700 transition-colors flex items-center justify-center active:scale-95"
            aria-label="FlyAustria WhatsApp"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Navigation Links -->
      <div>
        <h3 class="text-[#FAF9F6] font-semibold text-sm tracking-wide uppercase mb-4">Quick Navigation</h3>
        <ul class="space-y-3 text-sm">
          <li><a href="/" class="hover:text-white transition-colors py-1 inline-block">Home</a></li>
          <li><a href="/about" class="hover:text-white transition-colors py-1 inline-block">About Us</a></li>
          <li><a href="/services" class="hover:text-white transition-colors py-1 inline-block">Services Breakdown</a></li>
          <li><a href="/universities" class="hover:text-white transition-colors py-1 inline-block">Austrian Public Universities</a></li>
          <li><a href="/process" class="hover:text-white transition-colors py-1 inline-block">Visa & Admission Process</a></li>
        </ul>
      </div>

      <!-- Resources & Legal -->
      <div>
        <h3 class="text-[#FAF9F6] font-semibold text-sm tracking-wide uppercase mb-4">Resources</h3>
        <ul class="space-y-3 text-sm">
          <li><a href="/testimonials" class="hover:text-white transition-colors py-1 inline-block">Student Success Stories</a></li>
          <li><a href="/blog" class="hover:text-white transition-colors py-1 inline-block">Austria Study Blog</a></li>
          <li><a href="/contact" class="hover:text-white transition-colors py-1 inline-block">Free Eligibility Assessment</a></li>
          <li><a href="/privacy" class="hover:text-white transition-colors py-1 inline-block">Privacy Policy</a></li>
          <li><a href="/terms" class="hover:text-white transition-colors py-1 inline-block">Terms of Service</a></li>
        </ul>
      </div>

      <!-- Kochi Office Contact Info -->
      <div>
        <h3 class="text-[#FAF9F6] font-semibold text-sm tracking-wide uppercase mb-4">Kochi Office</h3>
        <ul class="space-y-3 text-sm text-slate-400">
          <li class="flex items-start gap-2.5">
            <svg class="w-5 h-5 text-[#C8102E] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <span>3rd Floor, Express Towers, MG Road, Kochi, Kerala 682016</span>
          </li>
          <li class="flex items-center gap-2.5">
            <svg class="w-5 h-5 text-green-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            <a href="tel:+919876543210" class="hover:text-white transition-colors min-h-[40px] flex items-center">+91 98765 43210</a>
          </li>
          <li class="flex items-center gap-2.5">
            <svg class="w-5 h-5 text-sky-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <a href="mailto:info@flyaustria.in" class="hover:text-white transition-colors min-h-[40px] flex items-center">info@flyaustria.in</a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Copyright -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500 text-center sm:text-left">
      <p>© {currentYear} FlyAustria Study Abroad. All rights reserved.</p>
      <p class="flex flex-wrap items-center justify-center gap-2">
        <span>Designed for Kerala Students</span>
        <span>•</span>
        <span class="text-[#C8102E] font-medium">Vienna | Salzburg | Graz | Kochi</span>
      </p>
    </div>
  </div>
</footer>
