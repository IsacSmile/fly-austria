---
interface Props {
  title: string;
  description: string;
  icon: string;
  highlights: string[];
}

const { title, description, icon, highlights } = Astro.props;
const whatsappMessage = `Hi FlyAustria! I want more details about your service: ${title}`;
---

<div class="bg-white p-6 sm:p-8 rounded-2xl border border-slate-200/90 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group flex flex-col justify-between">
  <div>
    <!-- Icon Container -->
    <div class="w-12 h-12 rounded-xl bg-red-50 text-[#C8102E] flex items-center justify-center mb-6 group-hover:bg-[#C8102E] group-hover:text-white transition-colors duration-300 shadow-xs">
      <Fragment set:html={icon} />
    </div>
    
    <!-- Service Title -->
    <h3 class="text-lg sm:text-xl font-bold text-[#0F172A] mb-3 group-hover:text-[#C8102E] transition-colors font-serif">
      {title}
    </h3>
    
    <!-- Description -->
    <p class="text-slate-600 text-xs sm:text-sm leading-relaxed mb-6">
      {description}
    </p>
    
    <!-- Included Highlights Bullet Points -->
    <ul class="space-y-2.5 mb-6 border-t border-slate-100 pt-4">
      {highlights.map((h) => (
        <li class="flex items-start gap-2 text-xs font-semibold text-slate-700">
          <span class="text-emerald-600 font-bold shrink-0 mt-0.5">✓</span>
          <span>{h}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Micro WhatsApp CTA -->
  <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
    <a
      href={`https://wa.me/919876543210?text=${encodeURIComponent(whatsappMessage)}`}
      target="_blank"
      rel="noopener noreferrer"
      class="w-full min-h-[44px] bg-slate-50 hover:bg-[#0F172A] text-slate-800 hover:text-white border border-slate-200 text-xs font-bold uppercase tracking-wider py-3 px-4 rounded-xl flex items-center justify-center gap-2 transition-all shadow-xs active:scale-[0.99]"
    >
      <span>Enquire via WhatsApp</span>
      <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
        <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654z"/>
      </svg>
    </a>
  </div>
</div>
