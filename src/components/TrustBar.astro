---
const trustStats = [
  { label: 'Visa Success Rate', stat: '98%', desc: 'Austrian Student Residence Permits' },
  { label: 'Kerala Students Placed', stat: '150+', desc: 'In Vienna, Graz, Linz & Innsbruck' },
  { label: 'Public Tuition Fee', stat: '€726.72', desc: 'Per Semester (~₹70,000 INR)' },
  { label: 'Exclusive Focus', stat: '100%', desc: 'Austria Public Universities Only' },
];
---

<section class="bg-white border-y border-slate-200/80 py-6 sm:py-8 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 text-center">
      {trustStats.map((item) => (
        <div class="bg-[#FAF9F6] p-4 sm:p-5 rounded-2xl border border-slate-200/70 space-y-1">
          <div class="text-2xl sm:text-4xl font-extrabold text-[#0F172A] tracking-tight flex items-center justify-center gap-1">
            <span class="text-[#C8102E]">{item.stat}</span>
          </div>
          <div class="text-xs sm:text-sm font-extrabold text-slate-800">{item.label}</div>
          <div class="text-[10px] sm:text-xs text-slate-500 font-medium leading-tight">{item.desc}</div>
        </div>
      ))}
    </div>
  </div>
</section>
