---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
import { db, consultations, enquiries } from '../../db';
import { COOKIE_NAME, verifySessionToken } from '../../lib/adminAuth';

const token = Astro.cookies.get(COOKIE_NAME)?.value;
if (!verifySessionToken(token)) {
  return Astro.redirect('/admin/login');
}

// Fetch all consultations & leads
let allConsultations = [];
let allLeads = [];

try {
  allConsultations = await db.select().from(consultations);
  allLeads = await db.select().from(enquiries);
} catch (err) {
  allConsultations = [];
  allLeads = [];
}

allConsultations.sort((a, b) => new Date(b.dateTime).getTime() - new Date(a.dateTime).getTime());
---

<AdminLayout title="1-on-1 Consultations" subtitle="Schedule and manage personal student counseling sessions">
  
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
    
    <!-- Left Column: Create New Consultation Form (4 cols) -->
    <div class="lg:col-span-4 bg-white p-6 rounded-3xl border border-slate-200/90 shadow-sm space-y-4">
      <h3 class="text-base font-extrabold text-[#0F172A] font-serif border-b border-slate-100 pb-3">
        Schedule 1-on-1 Session
      </h3>

      <form id="create-consultation-form" class="space-y-4 text-xs">
        
        <!-- Select Lead or Enter Name -->
        <div>
          <label class="block font-bold text-slate-800 mb-1">Student Lead</label>
          <select
            name="leadId"
            id="lead-select"
            class="w-full p-2.5 rounded-xl border border-slate-200 font-medium bg-slate-50 focus:ring-2 focus:ring-[#C8102E]"
            required
          >
            <option value="">-- Select Student Lead --</option>
            {allLeads.map((l) => (
              <option value={l.id} data-name={l.fullName}>
                {l.fullName} ({l.whatsappNumber})
              </option>
            ))}
          </select>
          <input type="hidden" name="leadName" id="lead-name-input" value="" />
        </div>

        <!-- Date & Time -->
        <div>
          <label class="block font-bold text-slate-800 mb-1">Date & Time</label>
          <input
            type="datetime-local"
            name="dateTime"
            class="w-full p-2.5 rounded-xl border border-slate-200 font-medium bg-white focus:ring-2 focus:ring-[#C8102E]"
            required
          />
        </div>

        <!-- Consultation Mode -->
        <div>
          <label class="block font-bold text-slate-800 mb-1">Consultation Mode</label>
          <select
            name="mode"
            class="w-full p-2.5 rounded-xl border border-slate-200 font-bold bg-white focus:ring-2 focus:ring-[#C8102E]"
          >
            <option value="WhatsApp Call">💬 WhatsApp Video / Call</option>
            <option value="In-Person Kochi">🏢 In-Person (Express Towers Kochi)</option>
            <option value="Zoom">💻 Zoom Online Meeting</option>
          </select>
        </div>

        <!-- Agenda / Initial Notes -->
        <div>
          <label class="block font-bold text-slate-800 mb-1">Session Agenda / Notes</label>
          <textarea
            name="notes"
            rows="3"
            placeholder="Document checklist review, university selection, MEA apostille guidance..."
            class="w-full p-2.5 rounded-xl border border-slate-200 font-medium bg-white focus:ring-2 focus:ring-[#C8102E]"
          ></textarea>
        </div>

        <button
          type="submit"
          class="w-full py-3 bg-[#0F172A] hover:bg-[#C8102E] text-white font-bold rounded-xl transition-colors shadow-md cursor-pointer"
        >
          Confirm Scheduled Session
        </button>

      </form>
    </div>

    <!-- Right Column: Consultations List Table (8 cols) -->
    <div class="lg:col-span-8 bg-white p-6 rounded-3xl border border-slate-200/90 shadow-sm space-y-4">
      <div class="flex items-center justify-between border-b border-slate-100 pb-3">
        <div>
          <h3 class="text-base font-extrabold text-[#0F172A] font-serif">Scheduled & Past Sessions</h3>
          <p class="text-xs text-slate-500">Track student advisory meetings & outcomes</p>
        </div>
        <span class="px-2.5 py-1 rounded-full bg-slate-100 text-slate-700 font-bold text-[10px]">
          {allConsultations.length} Sessions Total
        </span>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-xs">
          <thead>
            <tr class="bg-slate-50 border-b border-slate-200 text-slate-600 font-bold uppercase text-[10px] tracking-wider">
              <th class="py-3 px-4">Student</th>
              <th class="py-3 px-4">Date & Time</th>
              <th class="py-3 px-4">Mode</th>
              <th class="py-3 px-4">Notes / Outcome</th>
              <th class="py-3 px-4">Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 text-slate-800 font-medium">
            {allConsultations.length === 0 ? (
              <tr>
                <td colspan="5" class="py-12 text-center text-slate-400 font-medium">
                  No 1-on-1 consultations scheduled yet. Use the form to book a session.
                </td>
              </tr>
            ) : (
              allConsultations.map((c) => (
                <tr class="hover:bg-slate-50/80 transition-colors">
                  <td class="py-3.5 px-4 font-bold text-slate-900">{c.leadName}</td>
                  <td class="py-3.5 px-4 font-mono text-[11px] text-slate-600">
                    {new Date(c.dateTime).toLocaleString([], { dateStyle: 'short', timeStyle: 'short' })}
                  </td>
                  <td class="py-3.5 px-4">
                    <span class="px-2 py-0.5 rounded bg-slate-100 font-bold text-[10px] text-slate-700">
                      {c.mode}
                    </span>
                  </td>
                  <td class="py-3.5 px-4 max-w-[200px] text-slate-600 truncate">
                    {c.notes || c.outcome || 'No notes added'}
                  </td>
                  <td class="py-3.5 px-4">
                    <span class={`px-2.5 py-1 rounded-full text-[10px] font-extrabold uppercase ${
                      c.status === 'scheduled' ? 'bg-amber-100 text-amber-800 border border-amber-200' :
                      c.status === 'completed' ? 'bg-emerald-100 text-emerald-800 border border-emerald-200' :
                      'bg-slate-100 text-slate-600'
                    }`}>
                      {c.status}
                    </span>
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>

    </div>

  </div>

</AdminLayout>

<script>
  // Handle Lead name sync
  const select = document.getElementById('lead-select') as HTMLSelectElement;
  const nameInput = document.getElementById('lead-name-input') as HTMLInputElement;

  select?.addEventListener('change', () => {
    const selectedOption = select.options[select.selectedIndex];
    if (selectedOption) {
      nameInput.value = selectedOption.getAttribute('data-name') || '';
    }
  });

  // Form submission
  document.getElementById('create-consultation-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const formData = new FormData(form);

    const payload = {
      leadId: formData.get('leadId'),
      leadName: formData.get('leadName') || select.options[select.selectedIndex]?.text,
      dateTime: formData.get('dateTime'),
      mode: formData.get('mode'),
      notes: formData.get('notes'),
    };

    try {
      const res = await fetch('/api/admin/consultations/save', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      if (res.ok) {
        alert('✅ Consultation scheduled successfully!');
        window.location.reload();
      } else {
        alert('❌ Failed to schedule consultation.');
      }
    } catch (err) {
      alert('❌ Error saving consultation.');
    }
  });
</script>
