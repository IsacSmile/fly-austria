---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
import { db, blogPosts } from '../../db';
import { COOKIE_NAME, verifySessionToken } from '../../lib/adminAuth';

const token = Astro.cookies.get(COOKIE_NAME)?.value;
if (!verifySessionToken(token)) {
  return Astro.redirect('/admin/login');
}

let allPosts = [];
try {
  allPosts = await db.select().from(blogPosts);
} catch (err) {
  allPosts = [];
}
---

<AdminLayout title="Blog CMS Manager" subtitle="Manage SEO articles, visa guides & study abroad content">
  
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
    
    <!-- Create Blog Article Form (5 cols) -->
    <div class="lg:col-span-5 bg-white p-6 rounded-3xl border border-slate-200/90 shadow-sm space-y-4">
      <h3 class="text-base font-extrabold text-[#0F172A] font-serif border-b border-slate-100 pb-3">
        Create Blog Article
      </h3>

      <form id="create-blog-form" class="space-y-3.5 text-xs">
        <div>
          <label class="block font-bold text-slate-800 mb-1">Article Title</label>
          <input
            type="text"
            id="blog-title-input"
            name="title"
            placeholder="e.g. Austrian Student Visa Document Checklist 2026"
            class="w-full p-2.5 rounded-xl border border-slate-200 font-medium bg-slate-50 focus:ring-2 focus:ring-[#C8102E]"
            required
          />
        </div>

        <div>
          <label class="block font-bold text-slate-800 mb-1">URL Slug (Auto-generated)</label>
          <input
            type="text"
            id="blog-slug-input"
            name="slug"
            placeholder="austria-student-visa-checklist-2026"
            class="w-full p-2.5 rounded-xl border border-slate-200 font-mono text-[11px] bg-white focus:ring-2 focus:ring-[#C8102E]"
            required
          />
        </div>

        <div>
          <label class="block font-bold text-slate-800 mb-1">Short Excerpt (SEO Summary)</label>
          <textarea
            name="excerpt"
            rows="2"
            placeholder="Short 2-sentence summary for search engines and social cards..."
            class="w-full p-2.5 rounded-xl border border-slate-200 font-medium bg-white focus:ring-2 focus:ring-[#C8102E]"
            required
          ></textarea>
        </div>

        <div>
          <label class="block font-bold text-slate-800 mb-1">Full Article Content (Markdown)</label>
          <textarea
            name="content"
            rows="6"
            placeholder="# Guide Title&#10;&#10;Write full article content using markdown..."
            class="w-full p-3 rounded-xl border border-slate-200 font-mono text-[11px] bg-white focus:ring-2 focus:ring-[#C8102E]"
            required
          ></textarea>
        </div>

        <div>
          <label class="block font-bold text-slate-800 mb-1">Cover Image URL</label>
          <input
            type="text"
            name="coverImage"
            placeholder="https://images.unsplash.com/..."
            class="w-full p-2.5 rounded-xl border border-slate-200 font-medium bg-white focus:ring-2 focus:ring-[#C8102E]"
          />
        </div>

        <div class="grid grid-cols-2 gap-2">
          <div>
            <label class="block font-bold text-slate-800 mb-1">Author</label>
            <input
              type="text"
              name="author"
              defaultValue="Faiz I. (Executive Counselor)"
              class="w-full p-2.5 rounded-xl border border-slate-200 font-bold bg-white focus:ring-2 focus:ring-[#C8102E]"
            />
          </div>

          <div>
            <label class="block font-bold text-slate-800 mb-1">Publication Status</label>
            <select
              name="status"
              class="w-full p-2.5 rounded-xl border border-slate-200 font-bold bg-white focus:ring-2 focus:ring-[#C8102E]"
            >
              <option value="published">Published</option>
              <option value="draft">Draft</option>
            </select>
          </div>
        </div>

        <button
          type="submit"
          class="w-full py-3 bg-[#0F172A] hover:bg-[#C8102E] text-white font-bold rounded-xl transition-colors shadow-md cursor-pointer"
        >
          Publish Blog Article
        </button>
      </form>
    </div>

    <!-- Active Blog Articles List (7 cols) -->
    <div class="lg:col-span-7 bg-white p-6 rounded-3xl border border-slate-200/90 shadow-sm space-y-4">
      <div class="flex items-center justify-between border-b border-slate-100 pb-3">
        <div>
          <h3 class="text-base font-extrabold text-[#0F172A] font-serif">Published Blog Articles</h3>
          <p class="text-xs text-slate-500">Manage SEO articles visible on /blog</p>
        </div>
        <span class="px-2.5 py-1 rounded-full bg-slate-100 text-slate-700 font-bold text-[10px]">
          {allPosts.length} Articles
        </span>
      </div>

      <div class="space-y-3">
        {allPosts.length === 0 ? (
          <p class="text-xs text-slate-400 py-8 text-center font-medium">No blog posts created yet.</p>
        ) : (
          allPosts.map((post) => (
            <div class="p-4 rounded-2xl bg-[#FAF9F6] border border-slate-200/80 space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-[10px] font-extrabold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200 uppercase">
                  {post.status}
                </span>
                <span class="text-[10px] text-slate-400">{post.publishedAt}</span>
              </div>
              <h4 class="font-bold text-slate-900 text-sm">{post.title}</h4>
              <p class="text-xs text-slate-600 line-clamp-2">{post.excerpt}</p>
              <div class="pt-2 border-t border-slate-200/60 flex items-center justify-between text-[10px] text-slate-500">
                <span>Author: {post.author}</span>
                <a href={`/blog/${post.slug}`} target="_blank" class="font-bold text-[#C8102E] hover:underline">
                  View Public Post →
                </a>
              </div>
            </div>
          ))
        )}
      </div>

    </div>

  </div>

</AdminLayout>

<script>
  // Auto generate slug from title
  const titleInput = document.getElementById('blog-title-input') as HTMLInputElement;
  const slugInput = document.getElementById('blog-slug-input') as HTMLInputElement;

  titleInput?.addEventListener('input', () => {
    slugInput.value = titleInput.value
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/(^-|-$)+/g, '');
  });

  // Submit blog post
  document.getElementById('create-blog-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const formData = new FormData(form);

    const payload = {
      title: formData.get('title'),
      slug: formData.get('slug'),
      excerpt: formData.get('excerpt'),
      content: formData.get('content'),
      coverImage: formData.get('coverImage') || 'https://images.unsplash.com/photo-1516483638261-f4dbaf036963',
      author: formData.get('author'),
      status: formData.get('status'),
    };

    try {
      const res = await fetch('/api/admin/blog/save', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      if (res.ok) {
        alert('✅ Blog article published successfully!');
        window.location.reload();
      } else {
        alert('❌ Failed to publish blog article.');
      }
    } catch (err) {
      alert('❌ Error publishing blog article.');
    }
  });
</script>
