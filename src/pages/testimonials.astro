---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import TestimonialSlider from '../components/TestimonialSlider.astro';
import LeadMagnetSection from '../components/LeadMagnetSection.astro';
import { db, testimonials } from '../db';

const allTestimonials = await db.select().from(testimonials);
---

<BaseLayout
  title="Student Success Stories | FlyAustria Study Abroad Kochi"
  description="Read authentic reviews and success stories from Kerala students studying in Austrian public universities (University of Vienna, TU Graz, TU Wien)."
>
  <PageHero
    badgeText="VERIFIED STUDENT REVIEWS"
    titlePrefix="Real Stories from"
    titleHighlight="Kerala Students"
    titleSuffix="in Austria!"
    subtitle="Discover how graduates from Ernakulam, Trivandrum, Calicut & Thrissur secured admissions & visas."
    description="Hear authentic experiences regarding public university admissions, student dorm life in Vienna and Graz, part-time job opportunities, and living expenses."
    primaryCtaText="BOOK FREE CONSULTATION"
    primaryCtaLink="/#contact-section"
    secondaryCtaText="INSTAGRAM"
    secondaryCtaLink="https://instagram.com"
    highlightsTitle="STUDENT PROFILES"
    highlightsBadge="100% REAL"
    highlights={[
      { icon: "🎓", title: "Arjun S.", subtitle: "M.Sc CS • TU Graz" },
      { icon: "🎓", title: "Pooja N.", subtitle: "M.Sc Data • Uni Vienna" },
      { icon: "🎓", title: "Rohan V.", subtitle: "B.Sc Business • WU Vienna" },
      { icon: "🎓", title: "Ananya M.", subtitle: "M.Sc Biotech • JKU Linz" }
    ]}
  />

  <TestimonialSlider />

  <!-- Lazy-loaded Video Embed Placeholder -->
  <section class="py-12 bg-[#FAF9F6]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-white p-8 rounded-3xl border border-slate-200 shadow-sm max-w-4xl mx-auto text-center space-y-4">
        <span class="inline-block px-3 py-1 text-xs font-bold text-[#C8102E] bg-red-50 rounded-full border border-red-100">
          Video Experience
        </span>
        <h3 class="text-2xl font-extrabold text-[#0F172A]">Watch Kerala Students in Vienna & Graz</h3>
        <p class="text-xs text-slate-600 max-w-xl mx-auto">
          Hear directly from students about student dorm life in Graz, public transit in Vienna, part-time jobs, and monthly living costs.
        </p>

        <div class="relative w-full aspect-video bg-slate-900 rounded-2xl overflow-hidden flex items-center justify-center border border-slate-800 group cursor-pointer mt-4">
          <div class="text-center space-y-3 p-6 z-10">
            <div class="w-16 h-16 rounded-full bg-[#C8102E] text-white flex items-center justify-center mx-auto shadow-xl group-hover:scale-110 transition-transform">
              <svg class="w-8 h-8 fill-current ml-1" viewBox="0 0 24 24">
                <path d="M8 5v14l11-7z"/>
              </svg>
            </div>
            <p class="text-xs font-semibold text-slate-300">Click to Play Kerala Student Vlogs in Vienna</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <LeadMagnetSection />
</BaseLayout>
