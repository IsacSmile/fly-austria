---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';

const isSubmitted = Astro.url.searchParams.get('submitted') === 'true';
---

<BaseLayout
  title="Contact FlyAustria Study Abroad | Kochi Office & Consultation"
  description="Contact FlyAustria Study Abroad in Kochi, Kerala. Book a free profile assessment, ask questions on WhatsApp, or visit our MG Road office."
>
  <PageHero
    badgeText="WE ARE HERE TO HELP YOU"
    titlePrefix="Connect with"
    titleHighlight="FlyAustria Kochi"
    titleSuffix="for Instant Support!"
    subtitle="Speak with our Austrian public university specialists directly via WhatsApp, phone, or in-person at our Kochi office."
    description="Have questions regarding your CGPA eligibility, medium of instruction certificate, or student residence permit? Our counselors respond within 15 minutes."
    primaryCtaText="BOOK FREE CONSULTATION"
    primaryCtaLink="#contact-form-anchor"
    secondaryCtaText="INSTAGRAM"
    secondaryCtaLink="https://instagram.com"
    highlightsTitle="CONTACT CHANNELS"
    highlightsBadge="INSTANT"
    highlights={[
      { icon: "💬", title: "WhatsApp", subtitle: "Replies in <15 Mins" },
      { icon: "📍", title: "Kochi Office", subtitle: "MG Road, Express Towers" },
      { icon: "📞", title: "Direct Phone", subtitle: "+91 98765 43210" },
      { icon: "✉️", title: "Official Email", subtitle: "info@flyaustria.in" }
    ]}
  />

  <section class="py-16 bg-[#FAF9F6]" id="contact-form-anchor">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        
        <!-- Quick Contact Info Cards -->
        <div class="lg:col-span-5 space-y-6">
          
          <div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-sm space-y-6">
            <h3 class="text-xl font-bold text-[#0F172A] border-b border-slate-100 pb-3">Fastest Response Channels</h3>
            
            <div class="space-y-4">
              <!-- WhatsApp Card -->
              <a
                href="https://wa.me/919876543210?text=Hi%20FlyAustria!%20I%20want%20to%20schedule%20a%20free%20consultation%20in%20Kochi."
                target="_blank"
                rel="noopener noreferrer"
                class="p-4 rounded-2xl bg-green-50 border border-green-200 hover:border-green-300 transition-all flex items-center justify-between group"
              >
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-xl bg-[#25D366] text-white flex items-center justify-center shrink-0">
                    <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
                      <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654z"/>
                    </svg>
                  </div>
                  <div>
                    <h4 class="text-sm font-bold text-slate-900 group-hover:text-green-700">Official WhatsApp (Primary)</h4>
                    <p class="text-xs text-slate-500">+91 98765 43210 • Replies in under 15 mins</p>
                  </div>
                </div>
                <span class="text-xs font-bold text-green-700">Chat →</span>
              </a>

              <!-- Instagram DM -->
              <a
                href="https://instagram.com/flyaustria.in"
                target="_blank"
                rel="noopener noreferrer"
                class="p-4 rounded-2xl bg-pink-50 border border-pink-200 hover:border-pink-300 transition-all flex items-center justify-between group"
              >
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-purple-600 to-pink-500 text-white flex items-center justify-center shrink-0">
                    <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                      <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069z"/>
                    </svg>
                  </div>
                  <div>
                    <h4 class="text-sm font-bold text-slate-900 group-hover:text-pink-700">Instagram DM</h4>
                    <p class="text-xs text-slate-500">@flyaustria.in</p>
                  </div>
                </div>
                <span class="text-xs font-bold text-pink-700">DM Us →</span>
              </a>
            </div>
          </div>

          <!-- Office Location Details -->
          <div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-sm space-y-4">
            <h4 class="text-base font-bold text-slate-900">Kochi Office Address</h4>
            <p class="text-xs text-slate-600 leading-relaxed">
              FlyAustria Study Abroad<br/>
              3rd Floor, Express Towers, MG Road<br/>
              Kochi, Kerala 682016, India
            </p>
            <div class="pt-2 border-t border-slate-100 flex items-center justify-between text-xs">
              <span class="text-slate-500">Office Hours: Mon - Sat (9:30 AM - 6 PM)</span>
            </div>
          </div>

        </div>

        <!-- Contact Form -->
        <div class="lg:col-span-7">
          <ContactForm success={isSubmitted} />
        </div>

      </div>
    </div>
  </section>
</BaseLayout>
